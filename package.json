{
  "name": "Css intellisense Acode",
  "version": "1.0.0",
  "description": "JavaScript template for Acode plugins",
  "main": "dist/main.js",
  "repository": "https://github.com/Acode-Foundation/acode-plugin.git",
  "author": "Acode Foundation",
  "license": "MIT",
  "dependencies": {
    "@adobe/css-tools": "^4.4.0",
    "acode-plugin-types": "^1.12.9",
    "css-loader": "^7.1.2",
    "html-tag-js": "^2.4.15",
    "isomorphic-git": "^1.32.1",
    "style-loader": "^4.0.0"
  },
  "devDependencies": {
    "commitizen": "^4.3.2",
    "cz-customizable": "^7.5.4",
    "esbuild": "^0.27.2",
    "esbuild-sass-plugin": "^3.7.0",
    "jszip": "^3.10.1"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --serve",
    "build": "node esbuild.config.mjs",
    "commit": "cz"
  },
  "browserslist": "cover 100%,not android < 5",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-customizable"
    },
    "cz-customizable": {
      "config": "cz-config.js"
    }
  }
}